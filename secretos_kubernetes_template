#!/usr/bin/env bash
# ==============================================================================
# POLARIS Logistics — Template de Secrets de Kubernetes
# ==============================================================================
# Uso:
#   1. Copia este archivo (ej. k8s-secrets.sh) y NO lo commitees a git.
#   2. Reemplaza todos los valores CHANGE_ME con los reales.
#   3. export KUBECONFIG=$HOME/.kube/config   (o corre con sudo)
#   4. bash k8s-secrets.sh
#
# Este script es idempotente (usa --dry-run=client -o yaml | kubectl apply -f -)
# así que se puede volver a correr sin romper nada si algún secret ya existe.
#
# IMPORTANTE — orden y consistencia:
#   - Corre esto ANTES o justo cuando el pod de Postgres esté en ContainerCreating
#     (la primera vez que arranca sobre un volumen vacío). Si Postgres ya
#     inicializó con una contraseña distinta a la de este script, cambiar el
#     Secret NO cambia la contraseña real dentro de la base de datos —
#     tendrías que hacer ALTER USER ... PASSWORD ... manualmente.
#   - AIRFLOW_DB_PASSWORD y RABBITMQ_PASSWORD deben ser el MISMO valor tanto
#     en el secret de la base de datos como en las connection strings de Airflow.
# ==============================================================================

set -euo pipefail

# ------------------------------------------------------------------------------
# 0. Namespaces
# ------------------------------------------------------------------------------
kubectl create namespace data       --dry-run=client -o yaml | kubectl apply -f -
kubectl create namespace airflow    --dry-run=client -o yaml | kubectl apply -f -
kubectl create namespace monitoring --dry-run=client -o yaml | kubectl apply -f -

# ------------------------------------------------------------------------------
# 1. Postgres (namespace: data)
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD="CHANGE_ME"        # contraseña del superusuario "postgres"
AIRFLOW_DB_PASSWORD="CHANGE_ME"      # contraseña del usuario "airflow" en Postgres

kubectl create secret generic postgres-creds \
  --from-literal=postgres-password="${POSTGRES_PASSWORD}" \
  --from-literal=password="${AIRFLOW_DB_PASSWORD}" \
  -n data --dry-run=client -o yaml | kubectl apply -f -

# ------------------------------------------------------------------------------
# 2. RabbitMQ (namespace: data)
# ------------------------------------------------------------------------------
RABBITMQ_PASSWORD="CHANGE_ME"

kubectl create secret generic rabbitmq-creds \
  --from-literal=rabbitmq-password="${RABBITMQ_PASSWORD}" \
  -n data --dry-run=client -o yaml | kubectl apply -f -

# ------------------------------------------------------------------------------
# 3. Airflow — conexiones (namespace: airflow)
# ------------------------------------------------------------------------------
# Nota: metadata/resultBackend/broker necesitan la CONNECTION STRING completa
# (incluye usuario y password), no solo el password suelto — así lo exige
# el chart apache-airflow cuando usas *SecretName en vez de los bloques
# data.*Connection.
POSTGRES_HOST="postgres-postgresql.data.svc.cluster.local"
RABBITMQ_HOST="rabbitmq.data.svc.cluster.local"

kubectl create secret generic airflow-metadata \
  --from-literal=connection="postgresql://airflow:${AIRFLOW_DB_PASSWORD}@${POSTGRES_HOST}:5432/airflow?sslmode=disable" \
  -n airflow --dry-run=client -o yaml | kubectl apply -f -

kubectl create secret generic airflow-result-backend \
  --from-literal=connection="db+postgresql://airflow:${AIRFLOW_DB_PASSWORD}@${POSTGRES_HOST}:5432/airflow?sslmode=disable" \
  -n airflow --dry-run=client -o yaml | kubectl apply -f -

kubectl create secret generic airflow-broker-url \
  --from-literal=connection="amqp://airflow:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:5672/" \
  -n airflow --dry-run=client -o yaml | kubectl apply -f -

# ------------------------------------------------------------------------------
# 4. Airflow — claves de seguridad (namespace: airflow)
# ------------------------------------------------------------------------------
# fernet-key: generar con   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# api-secret-key / jwt-secret: generar con   openssl rand -hex 32   (o similar)
FERNET_KEY="CHANGE_ME"
API_SECRET_KEY="CHANGE_ME"
JWT_SECRET="CHANGE_ME"

kubectl create secret generic airflow-fernet-key \
  --from-literal=fernet-key="${FERNET_KEY}" \
  -n airflow --dry-run=client -o yaml | kubectl apply -f -

kubectl create secret generic airflow-api-secret-key \
  --from-literal=api-secret-key="${API_SECRET_KEY}" \
  -n airflow --dry-run=client -o yaml | kubectl apply -f -

kubectl create secret generic airflow-jwt-secret \
  --from-literal=jwt-secret="${JWT_SECRET}" \
  -n airflow --dry-run=client -o yaml | kubectl apply -f -

# ------------------------------------------------------------------------------
# 5. Grafana (namespace: monitoring)
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="CHANGE_ME"

kubectl create secret generic grafana-admin-creds \
  --from-literal=admin-user="${GRAFANA_ADMIN_USER}" \
  --from-literal=admin-password="${GRAFANA_ADMIN_PASSWORD}" \
  -n monitoring --dry-run=client -o yaml | kubectl apply -f -

# ------------------------------------------------------------------------------
# 6. Warehouse DB — base analítica del ETL (namespace: data)
# ------------------------------------------------------------------------------
WAREHOUSE_DB_USER="CHANGE_ME"
WAREHOUSE_DB_PASSWORD="CHANGE_ME"
WAREHOUSE_DB_NAME="CHANGE_ME"

kubectl create secret generic warehouse-creds \
  --from-literal=username="${WAREHOUSE_DB_USER}" \
  --from-literal=password="${WAREHOUSE_DB_PASSWORD}" \
  --from-literal=database="${WAREHOUSE_DB_NAME}" \
  -n data --dry-run=client -o yaml | kubectl apply -f -

# ------------------------------------------------------------------------------
# 7. Airflow ETL — credenciales del DAG (namespace: airflow)
# ------------------------------------------------------------------------------
KAGGLE_API_TOKEN="CHANGE_ME"
ETL_POSTGRES_HOST="postgres-postgresql.data.svc.cluster.local"
ETL_POSTGRES_PORT="5432"
ETL_POSTGRES_DB="${WAREHOUSE_DB_NAME}"
ETL_POSTGRES_USER="${WAREHOUSE_DB_USER}"
ETL_POSTGRES_PASSWORD="${WAREHOUSE_DB_PASSWORD}"

kubectl create secret generic polaris-etl-secrets \
  --from-literal=KAGGLE_API_TOKEN="${KAGGLE_API_TOKEN}" \
  --from-literal=ETL_POSTGRES_HOST="${ETL_POSTGRES_HOST}" \
  --from-literal=ETL_POSTGRES_PORT="${ETL_POSTGRES_PORT}" \
  --from-literal=ETL_POSTGRES_DB="${ETL_POSTGRES_DB}" \
  --from-literal=ETL_POSTGRES_USER="${ETL_POSTGRES_USER}" \
  --from-literal=ETL_POSTGRES_PASSWORD="${ETL_POSTGRES_PASSWORD}" \
  -n airflow --dry-run=client -o yaml | kubectl apply -f -

# ------------------------------------------------------------------------------
# 8. AWS EBS CSI Driver (namespace: kube-system)
# ------------------------------------------------------------------------------
# ¡OJO! Este Secret ya lo crea automáticamente el role de Ansible
# `ebs_csi_driver` (con las keys "key_id" y "access_key", NO
# "AWS_ACCESS_KEY_ID"/"AWS_SECRET_ACCESS_KEY"). Si ya corriste el playbook,
# NO ejecutes este bloque — sobrescribirías el Secret con keys distintas y
# romperías el driver (CrashLoopBackOff). Déjalo aquí solo como referencia
# de qué existe / para recrearlo manualmente si hiciera falta.
#
# EBS_CSI_KEY_ID="CHANGE_ME"
# EBS_CSI_ACCESS_KEY="CHANGE_ME"
#
# kubectl create secret generic aws-secret \
#   --from-literal=key_id="${EBS_CSI_KEY_ID}" \
#   --from-literal=access_key="${EBS_CSI_ACCESS_KEY}" \
#   -n kube-system --dry-run=client -o yaml | kubectl apply -f -

echo "Todos los Secrets fueron creados/actualizados."